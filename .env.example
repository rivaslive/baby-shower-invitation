# Cadena de conexión de MongoDB (Atlas u otro). En desarrollo, si la dejas vacía
# se levanta una base local automática (mongodb-memory-server) guardada en .mongo-data/
MONGODB_URI=
MONGODB_DB=babyshower

# Clave para entrar a /admin y crear invitaciones
ADMIN_KEY=cambia-esta-clave

# URL pública del sitio (para la vista previa en WhatsApp)
VITE_SITE_URL=http://localhost:5173
